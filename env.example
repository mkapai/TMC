# ============================================
# TMC (Telegram Message Collector) 配置示例
# v1.3.0-test
# ============================================

# ==================== 基础配置 ====================
# Docker 镜像标签（test 分支默认使用 test 标签）
# 选项: test（测试版）, latest（稳定版）, v1.x.x（特定版本）
DOCKER_TAG=test

# 应用端口
APP_PORT=9393

# 时区
TZ=Asia/Shanghai

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# ==================== Telegram 配置 ====================
# 【推荐】通过 Web 界面为每个客户端单独配置，无需在此填写
# 以下仅作为默认值，当客户端未单独配置时使用

# API ID 和 API Hash (从 https://my.telegram.org 获取)
API_ID=
API_HASH=

# Bot Token (可选，从 @BotFather 获取)
BOT_TOKEN=

# 用户账号手机号 (可选，格式: +86xxxx)
PHONE_NUMBER=


# ==================== 代理配置（可选）====================
# 是否启用代理
ENABLE_PROXY=false

# 代理类型 (http, socks5)
PROXY_TYPE=http

# 代理地址
PROXY_HOST=127.0.0.1

# 代理端口
PROXY_PORT=7890


# ==================== 数据目录配置 ====================
# 数据库目录
DATA_PATH=./data

# 日志目录
LOGS_PATH=./logs

# Session 目录（重要：保存登录状态）
SESSIONS_PATH=./sessions

# 临时文件目录
TEMP_PATH=./temp

# 配置文件目录
CONFIG_PATH=./config


# ==================== 权限配置（NAS 推荐）====================
# 用户 ID（避免权限问题）
PUID=1000

# 用户组 ID
PGID=1000


# ==================== 数据库配置 ====================
# 数据库 URL（默认使用 SQLite）
DATABASE_URL=sqlite:////app/data/bot.db

# Webhook 资源公开访问地址，例如 https://tmc.example.com
PUBLIC_BASE_URL=

# 公开资源链接有效期（天）
PUBLIC_RESOURCE_TTL_DAYS=7

# 消息附件缓存目录和容量上限
RESOURCE_CACHE_DIR=data/message-resources
RESOURCE_CACHE_MAX_GB=100


# ==================== 高级配置（可选）====================
# JWT 密钥（用于 Web 登录，⚠️ 生产环境必须设置固定值）
# 如果不设置，每次重启都会生成新密钥，导致用户需要重新登录
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=your-secret-key-here

# 会话过期时间（分钟，默认24小时=1440分钟）
# JWT_EXPIRE_MINUTES=1440
